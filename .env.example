# DocIntel configuration.
# Copy to .env (repository root for Docker Compose, backend/.env for local runs).
# Every setting has a default; only the LLM block needs attention if you want model-based extraction.

# ---- LLM extraction (optional; the rule-based extractor runs when disabled) ----
# LLM_PROVIDER = rules | anthropic | gemini | groq | openai | ollama | openai_compatible
LLM_PROVIDER=rules
LLM_API_KEY=
LLM_MODEL=
# Required for openai_compatible gateways (OpenRouter, vLLM, LiteLLM, ...) or a remote Ollama host
LLM_BASE_URL=
# Examples:
#   LLM_PROVIDER=anthropic          LLM_MODEL=claude-haiku-4-5
#   LLM_PROVIDER=gemini             LLM_MODEL=gemini-2.5-flash
#   LLM_PROVIDER=groq               LLM_MODEL=llama-3.3-70b-versatile
#   LLM_PROVIDER=openai             LLM_MODEL=gpt-4o-mini
#   LLM_PROVIDER=ollama             LLM_MODEL=qwen2.5:7b-instruct   (local; documents stay on the machine)
#   LLM_PROVIDER=openai_compatible  LLM_BASE_URL=https://gateway.example.com/v1  LLM_MODEL=...

# ---- Model settings edited in the UI ----
# Administrators can change the provider, model, API key and OCR engine under Settings > Models & API.
# Saved keys are encrypted with SECRET_KEY. When empty, a random secret is generated once and stored in the data volume.
# SECRET_KEY=

# ---- Accounts and sessions ----
# Demo accounts (admin, reviewer, viewer) are created on first start. Their credentials are listed in the README.
# For a real deployment set SEED_DEMO_USERS=false, set the bootstrap administrator below, and COOKIE_SECURE=true behind HTTPS.
SEED_DEMO_USERS=true
# Allow self-service sign-up on the sign-in page (new accounts receive the reviewer role)
ALLOW_SIGNUP=true
COOKIE_SECURE=false
# Session length in hours, and in days when "Keep me signed in" is selected
SESSION_HOURS=12
REMEMBER_DAYS=30
# First administrator, created at start-up when no administrator exists:
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=
# Override the demo account passwords:
# DEMO_ADMIN_PASSWORD=
# DEMO_REVIEWER_PASSWORD=
# DEMO_VIEWER_PASSWORD=

# ---- Security ----
# Optional service-account key for scripts, sent as the X-API-Key header (reviewer permissions)
API_KEY=
POSTGRES_PASSWORD=docintel
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=200

# ---- Processing ----
# OCR engine: tesseract | rapidocr
OCR_ENGINE=tesseract
OCR_DPI=200
OCR_THREADS=2
# Worker processes under Docker Compose
WORKERS=2
# Reading order for ambiguous dates such as 03/04/2026: MDY | DMY
AMBIGUOUS_DATE_ORDER=MDY

# ---- Local (non-Docker) runs ----
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/docintel
# REDIS_URL=redis://localhost:6379/0
